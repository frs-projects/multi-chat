# multichat-bridge configuration. Everything is env-only - copy to .env (or set these
# in your deploy platform's UI) and go; no config files to edit.
#
# Dokploy: paste these into the service's Environment tab. Dokploy writes them to a
# .env next to the compose file in its repo clone on every deploy, which the compose
# file picks up automatically - you never touch any file.

## Redis ----------------------------------------------------------------------
# Must point at the same Redis + stream the Link-Mod servers use.
REDIS_URL=redis://127.0.0.1:6379
#REDIS_STREAM_KEY=multichat:events
#REDIS_MAX_STREAM_LENGTH=10000
# Skip missed messages older than this after bridge downtime (seconds).
#MAX_CATCHUP_AGE_SECONDS=300

## Discord --------------------------------------------------------------------
# The connector activates as soon as at least one DISCORD_CHANNEL_<n> group is set.
# Bot token: needed to read messages (inbound) and for outbound without a webhook.
# Remember to enable the "Message Content Intent" in the Discord developer portal!
DISCORD_TOKEN=
# Label stamped on messages coming FROM Discord.
#DISCORD_SOURCE_ID=discord
# Drop messages written by other bots.
#DISCORD_IGNORE_BOTS=true

# One numbered group per bridged channel; numbering starts at 1, first gap ends the
# list. _ID = channel id (inbound reading + bot-message fallback), _WEBHOOK = outbound
# with per-player name/avatar. At least one of the two is required per group.
DISCORD_CHANNEL_1_ID=
DISCORD_CHANNEL_1_WEBHOOK=
# Comma-separated filters; unset or * = everything.
#DISCORD_CHANNEL_1_TYPES=chat,join,leave,death,advancement,status
#DISCORD_CHANNEL_1_SOURCES=EU_1,EU_2
# Set false for announce-only channels (e.g. #server-status).
#DISCORD_CHANNEL_1_INBOUND=true

#DISCORD_CHANNEL_2_ID=
#DISCORD_CHANNEL_2_WEBHOOK=
#DISCORD_CHANNEL_2_TYPES=status
#DISCORD_CHANNEL_2_INBOUND=false

# Templates for non-chat types (chat goes through the webhook with the player's own
# name/avatar when one is configured). Placeholders: {source} {name} {message} {type}.
#DISCORD_FORMAT_CHAT=**[{source}]** {name}: {message}
#DISCORD_FORMAT_JOIN=*[{source}] {name} joined the game*
#DISCORD_FORMAT_LEAVE=*[{source}] {name} left the game*
#DISCORD_FORMAT_DEATH=*[{source}] {message}*
#DISCORD_FORMAT_ADVANCEMENT=*[{source}] {message}*
#DISCORD_FORMAT_STATUS=**[{source}] server {message}**
#DISCORD_FORMAT_DEFAULT=**[{source}]** {name}: {message}

# Bot status ("Watching 12 players on 3 servers"). The bridge counts players from
# join/leave events and servers from status events, so the numbers only reflect what
# happened since the bridge started. Needs DISCORD_TOKEN; ignored for webhook-only setups.
#DISCORD_PRESENCE_ENABLED=true
#DISCORD_PRESENCE_TEMPLATE={players} players on {servers} servers
# playing | streaming | listening | watching | custom | competing
#DISCORD_PRESENCE_ACTIVITY=watching

## CLI test connector ---------------------------------------------------------
# Prints stream messages to stdout, publishes stdin lines as chat. Dev/testing only.
#CLI_ENABLED=false
#CLI_SOURCE_ID=cli
